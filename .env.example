# ===== DOCKER IMAGES =====
IMAGE_PREFIX=ai-sous-chef
IMAGE_TAG=latest

# Compose file chain (optional; or pass -f flags)
COMPOSE_FILE=docker-compose.yml:docker-compose.dev.yml

# ===== POSTGRESQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sous_chef

# ===== BACKEND =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgresql:5432/ai_sous_chef

# ===== ENTRY (compose-nginx) =====
# local/dev default 8080; prod on VPS: 3101
NGINX_PORT=8080
NGINX_BIND=0.0.0.0
ACCESS_VIA_DOMAIN=false
APP_DOMAIN=ai-sous-chef.ru
# APP_PUBLIC_URL / HEALTHCHECK_URL на CI считаются из ACCESS_VIA_DOMAIN
HEALTHCHECK_URL=http://127.0.0.1:8080/health
APP_PUBLIC_URL=http://127.0.0.1:8080
