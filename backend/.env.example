# ===== DOCKER IMAGES =====
IMAGE_PREFIX=ai-sous-chef
IMAGE_TAG=latest

# ===== POSTGRESQL =====
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=ai_sous_chef

# ===== BACKEND =====
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgresql:5432/ai_sous_chef

YANDEX_FOLDER_ID="..."
YANDEX_API_KEY="..."

AI_MODE=stub

# Локальные заглушки. На стенде задать боевые значения.
CONSENT_JOURNAL_URL=http://consent.test
CONSENT_JOURNAL_API_KEY=csk_local_stub
CONSENT_PUBLIC_BASE=http://consent.test/t/ai-sous-chef

